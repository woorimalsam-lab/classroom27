rules_version = '2';

// ============================================================
//  우리말샘 핀 + 학급 게시판 통합 Firestore 보안 규칙
//  적용 방법: Firebase 콘솔 → Firestore Database → 규칙 탭에
//  이 파일 내용을 통째로 붙여넣고 [게시] 클릭
//  https://console.firebase.google.com/project/woorimalsam-7f454/firestore/rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 교사 본인 확인 (구글 로그인 이메일 기준)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'woorimalsam@gmail.com';
    }

    // ---- 우리말샘 핀: 개인 데이터 (메모·일정·할 일) ----
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- 학급 게시판: 공개 문서 (학급 일정·설문 문항) ----
    // 출결·명렬표는 여기 두지 않음(아래 classboard_class). 교사는 예전 문서 이전·정리를 위해 전체 접근
    match /classboard/{docId} {
      allow read: if docId in ['events', 'surveys'] || isTeacher();
      allow write: if isTeacher();
    }

    // ---- 학급 게시판: 우리 반 전용 (출결·명렬표, 이름은 가린 형태) ----
    // 문서 이름이 '학급코드_종류'라서 학급 링크를 받은 사람만 읽을 수 있음
    // 목록 조회(list)를 막아 문서 이름(=학급 코드)을 알아낼 수 없게 함
    match /classboard_class/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isTeacher();
    }

    // ---- 학급 게시판: 교사 전용 (학급 코드·실명 명단·비고) ----
    match /classboard_teacher/{docId} {
      allow read, write: if isTeacher();
    }

    // ---- 학급 게시판: 공지사항 ----
    match /classboard_notices/{noticeId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- 학급 게시판: 익명 메시지 ----
    // 학생은 로그인 없이 '보내기'만 가능, 읽기/삭제는 교사만
    match /classboard_messages/{msgId} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    // ---- 학급 게시판: 설문 응답 ----
    // 학생은 로그인 없이 '제출'만 가능, 전체 결과 열람·삭제는 교사만
    match /classboard_survey_responses/{respId} {
      allow create: if request.resource.data.surveyId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 30;
      allow read, delete: if isTeacher();
      allow update: if false;
    }
  }
}
